APP_NAME=AI Mock Interview Platform
ENVIRONMENT=local
DEBUG=true

JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:5173"]

# SQL Server / Azure SQL connection settings (raw pyodbc; matches infra/docker/docker-compose.yml and infra/k8s).
DATABASE_SERVER=localhost,1433
DATABASE_NAME=interview_db
DATABASE_USER=sa
DATABASE_PASSWORD=change-me-in-production
DATABASE_DRIVER=ODBC Driver 18 for SQL Server
DATABASE_ENCRYPT=true
DATABASE_TRUST_SERVER_CERTIFICATE=true
# Optional: fully overrides the assembled ODBC connection string above when set.
DATABASE_CONNECTION_STRING=

REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
RATE_LIMIT_DEFAULT=100/minute

AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o

AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-JennyNeural

STORAGE_ROOT=./storage

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

MAX_QUESTIONS_PER_INTERVIEW=20
